# OpenClaw Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub

# ===========================================
# Model Providers
# ===========================================

# Alibaba Cloud (DashScope) - for qwen3.5-plus model
DASHSCOPE_API_KEY="sk-your-actual-api-key-here"

# ===========================================
# Web Search
# ===========================================

# Kimi Web Search API Key
KIMI_SEARCH_API_KEY="your-kimi-api-key-here"

# ===========================================
# Feishu/Lark Channel
# ===========================================

# Feishu App Secret (for WebSocket connection)
FEISHU_APP_SECRET="your-actual-app-secret-here"

# ===========================================
# Gateway Authentication
# ===========================================

# Gateway token for local authentication
OPENCLAW_GATEWAY_TOKEN="your-gateway-token-here"
